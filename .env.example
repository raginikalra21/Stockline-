DB_USERNAME=stockline
DB_PASSWORD=replace-with-a-long-local-password
DB_PORT=5432
APP_PORT=8080
SPRING_PROFILES_ACTIVE=postgres
DB_POOL_MAX=24
DB_POOL_MIN_IDLE=4
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
SERVER_TOMCAT_MAX_THREADS=200
SERVER_TOMCAT_MIN_SPARE_THREADS=10
JWT_SECRET=replace-with-base64-encoded-random-32-byte-secret
STOCKLINE_ADMIN_USERNAME=admin
STOCKLINE_ADMIN_PASSWORD=replace-with-at-least-12-characters
STOCKLINE_SECURE_COOKIE=false
